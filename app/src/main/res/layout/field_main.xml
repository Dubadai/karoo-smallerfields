<?xml version="1.0" encoding="utf-8"?>
<!-- Any field size. The whole field is one bitmap drawn by TileRenderer. No background here: the
     Karoo draws its tile; the bitmap paints only what SmallerFields adds (cards, zone colours).
     No click handler, so the Karoo's long-press (change field) still works. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/field"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</FrameLayout>
